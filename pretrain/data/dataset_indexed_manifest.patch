 def list_parquet_files(data_dir=None, warn_on_legacy=False):
     """ Looks into a data dir and returns full paths to all parquet files. """
+    # Preserve checkpoint pq_idx offsets when only a contiguous subset is staged.
+    # This opt-in manifest lists ALL canonical shards, including unstaged paths.
+    # A missing shard fails at ParquetFile open; it never silently shifts indices.
+    manifest_path = os.environ.get("D34_SHARD_MANIFEST")
+    if manifest_path is not None:
+        data_root = os.environ.get("D34_DATA_ROOT")
+        if not manifest_path or not data_root or not os.path.isabs(data_root):
+            raise ValueError("D34_SHARD_MANIFEST requires an absolute D34_DATA_ROOT")
+        if data_dir is not None and os.path.realpath(data_dir) != os.path.realpath(data_root):
+            raise ValueError("Explicit data_dir disagrees with D34_DATA_ROOT")
+        with open(manifest_path, encoding="utf-8") as stream:
+            manifest = json.load(stream)
+        expected = [index_to_filename(i) for i in range(MAX_SHARD + 1)]
+        if manifest.get("format") != "d34-indexed-climbmix-v1" or manifest.get("parquet_basenames") != expected:
+            raise ValueError("Indexed ClimbMix manifest must contain all 6543 canonical basenames in order")
+        return [os.path.join(data_root, basename) for basename in expected]
+
